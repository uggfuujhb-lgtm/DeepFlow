//@version=6
// OptionLap · CVD panel (display only). Session CVD built from the smallest bars TradingView gives the script
// (1-minute by default, seconds if your plan allows), classified with the tick rule: a sub-bar that closes above the
// previous sub-bar's close = buying, below = selling, unchanged = its own colour, else the last direction.
// Divergences are marked when they are CONFIRMED (lbR bars after the price pivot), never drawn back in time.
// Tested in cvddiv_test.py (21 days x 9 symbols): divergences gave no edge. For reading the flow, not for entries.
// For education only, not a recommendation.
indicator("OptionLap · CVD", shorttitle="OL CVD", overlay=false, max_lines_count=200, max_labels_count=300)

grp = "الحساب"
ltf     = input.timeframe("1", "فريم الحساب الداخلي", group=grp, tooltip="أصغر = أدق. 1 دقيقة متاح للكل. لو اشتراكك يسمح بالثواني جرّب 5S أو 1S. لازم يكون أصغر من فريم الشارت")
sess    = input.session("0930-1600", "الجلسة (CVD يبدأ من صفر كل يوم)", group=grp)
tz      = input.string("America/New_York", "المنطقة الزمنية", group=grp)
rthOnly = input.bool(true, "احسب داخل الجلسة بس", group=grp)

grpD = "التباعد (Divergence)"
showDiv = input.bool(true, "علّم التباعد", group=grpD)
lbL     = input.int(5, "قاع/قمة: شموع يسار", minval=1, maxval=20, group=grpD)
lbR     = input.int(2, "قاع/قمة: شموع يمين (التأكيد)", minval=1, maxval=10, group=grpD, tooltip="التباعد يطلع بعد هالعدد من الشموع، في وقته الحقيقي")
minGap  = input.int(3, "أقل مسافة بين القاعين (شموع)", minval=1, group=grpD)
maxGap  = input.int(40, "أكبر مسافة (شموع)", minval=5, group=grpD)
onPrice = input.bool(true, "اكتب التباعد على شارت السعر كمان", group=grpD)

grpS = "الشكل"
style   = input.string("شموع", "شكل CVD", options=["شموع", "خط"], group=grpS)
showBar = input.bool(false, "اعرض دلتا كل شمعة (أعمدة بدل CVD)", group=grpS)
showTbl = input.bool(true, "اعرض جدول اليوم", group=grpS)
colUp   = input.color(#2EF2C8, "مشترين", group=grpS)
colDn   = input.color(#C98A6A, "بائعين", group=grpS)
colDiv  = input.color(#FFC21A, "التباعد", group=grpS)

// ───────── intrabar data ─────────
ltfE = timeframe.in_seconds(ltf) < timeframe.in_seconds() ? ltf : timeframe.period
[sc, so, sv] = request.security_lower_tf(syminfo.tickerid, ltfE, [close, open, volume])

inS    = not na(time(timeframe.period, sess, tz))
newDay = ta.change(time("D", "", tz)) != 0
sStart = inS and (not inS[1] or newDay)
active = not rthOnly or inS

var float cvd = 0.0
var float lastSub = na
var int   dir = 1
var float buyV = 0.0
var float sellV = 0.0
var int   sStartBar = na
if sStart or (not rthOnly and newDay)
    cvd := 0.0
    buyV := 0.0
    sellV := 0.0
    sStartBar := bar_index

float bo = cvd
float bh = cvd
float bl = cvd
float bd = 0.0
int n = array.size(sv)
if active
    if n > 0
        for i = 0 to n - 1
            c = array.get(sc, i)
            o = array.get(so, i)
            v = nz(array.get(sv, i))
            int d = na(lastSub) or c == lastSub ? (c > o ? 1 : c < o ? -1 : dir) : (c > lastSub ? 1 : -1)
            dir := d
            bd += d * v
            cvd += d * v
            buyV += d > 0 ? v : 0
            sellV += d < 0 ? v : 0
            bh := math.max(bh, cvd)
            bl := math.min(bl, cvd)
            lastSub := c
    else
        int d = close > close[1] ? 1 : close < close[1] ? -1 : dir
        dir := d
        bd := d * nz(volume)
        cvd += bd
        buyV += d > 0 ? nz(volume) : 0
        sellV += d < 0 ? nz(volume) : 0
        bh := math.max(bo, cvd)
        bl := math.min(bo, cvd)
        lastSub := close

isCandle = style == "شموع" and not showBar
cvdCol = cvd >= bo ? colUp : colDn
plotcandle(active and isCandle ? bo : na, active and isCandle ? bh : na, active and isCandle ? bl : na, active and isCandle ? cvd : na, "CVD", color=cvdCol, wickcolor=cvdCol, bordercolor=cvdCol)
plot(active and style == "خط" and not showBar ? cvd : na, "CVD خط", color=cvdCol, linewidth=2, style=plot.style_linebr)
plot(active and showBar ? bd : na, "دلتا الشمعة", color=bd >= 0 ? colUp : colDn, style=plot.style_columns)
hline(0, "صفر", color=color.new(color.gray, 50), linestyle=hline.style_dotted)

// ───────── divergences, marked at confirmation ─────────
pl = ta.pivotlow(low, lbL, lbR)
ph = ta.pivothigh(high, lbL, lbR)
var int   pLb = na
var float pLp = na
var float pLc = na
var int   pHb = na
var float pHp = na
var float pHc = na
pb = bar_index - lbR
inToday = not na(sStartBar) and pb >= sStartBar and active[lbR]
bullDiv = false
bearDiv = false
if not na(pl) and inToday
    cNow = cvd[lbR]
    if not na(pLb) and pLb >= sStartBar and pb - pLb >= minGap and pb - pLb <= maxGap and low[lbR] < pLp and cNow > pLc
        bullDiv := true
        if showDiv
            line.new(pLb, pLc, pb, cNow, color=colDiv, width=2)
            label.new(bar_index, bl, "تباعد ↑", style=label.style_label_up, color=color.new(colDiv, 20), textcolor=color.black, size=size.tiny)
            if onPrice
                label.new(bar_index, low, "CVD ↑", style=label.style_label_up, color=color.new(colDiv, 20), textcolor=color.black, size=size.tiny, force_overlay=true)
    pLb := pb
    pLp := low[lbR]
    pLc := cNow
if not na(ph) and inToday
    cNow = cvd[lbR]
    if not na(pHb) and pHb >= sStartBar and pb - pHb >= minGap and pb - pHb <= maxGap and high[lbR] > pHp and cNow < pHc
        bearDiv := true
        if showDiv
            line.new(pHb, pHc, pb, cNow, color=colDiv, width=2)
            label.new(bar_index, bh, "تباعد ↓", style=label.style_label_down, color=color.new(colDiv, 20), textcolor=color.black, size=size.tiny)
            if onPrice
                label.new(bar_index, high, "CVD ↓", style=label.style_label_down, color=color.new(colDiv, 20), textcolor=color.black, size=size.tiny, force_overlay=true)
    pHb := pb
    pHp := high[lbR]
    pHc := cNow
alertcondition(bullDiv, "OL CVD: bullish divergence", "تباعد CVD صاعد (تأكد الحين). للعرض بس، ما أثبت أفضلية")
alertcondition(bearDiv, "OL CVD: bearish divergence", "تباعد CVD نازل (تأكد الحين). للعرض بس، ما أثبت أفضلية")

// ───────── today's table ─────────
if showTbl and barstate.islast
    var table t = table.new(position.top_right, 2, 5, bgcolor=color.new(#17151f, 10), border_color=color.new(#2c2838, 0), border_width=1)
    tot = buyV + sellV
    table.cell(t, 0, 0, "CVD اليوم", text_color=#a49fb8, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(cvd, format.volume), text_color=cvd >= 0 ? colUp : colDn, text_size=size.small)
    table.cell(t, 0, 1, "دلتا آخر شمعة", text_color=#a49fb8, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(bd, format.volume), text_color=bd >= 0 ? colUp : colDn, text_size=size.small)
    table.cell(t, 0, 2, "مشترين / بائعين اليوم", text_color=#a49fb8, text_size=size.small)
    table.cell(t, 1, 2, tot > 0 ? str.tostring(buyV / tot * 100, "#") + "% / " + str.tostring(sellV / tot * 100, "#") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "الحساب من", text_color=#a49fb8, text_size=size.small)
    table.cell(t, 1, 3, n > 0 ? ltfE + " (" + str.tostring(n) + " داخل الشمعة)" : "الشمعة نفسها (تقريبي)", text_color=n > 0 ? color.white : #FF3B47, text_size=size.small)
    table.cell(t, 0, 4, "للعرض بس · ما أثبت أفضلية · للتعليم فقط", text_color=#a49fb8, text_size=size.tiny)
    table.merge_cells(t, 0, 4, 1, 4)
