// ───────── أدوات الرسم ─────────
var array<line>  gLines  = array.new<line>()
var array<label> gLabels = array.new<label>()
var array<box>   gBoxes  = array.new<box>()

f_clearAll() =>
    for l in gLines
        line.delete(l)
    for b in gLabels
        label.delete(b)
    for x in gBoxes
        box.delete(x)
    array.clear(gLines)
    array.clear(gLabels)
    array.clear(gBoxes)

f_line(float price, color col, int w, bool dashed) =>
    array.push(gLines, line.new(bar_index - 1, price, bar_index, price, extend=extend.both, color=col, width=w, style=dashed ? line.style_dashed : line.style_solid))

f_tag(float price, color col, string txt) =>
    array.push(gLabels, label.new(bar_index + 3, price, txt, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small))

f_band(float price, float half, color col, int transp) =>
    array.push(gBoxes, box.new(bar_index - 1, price + half, bar_index, price - half, border_color=color.new(col, 100), bgcolor=color.new(col, transp), extend=extend.both))

f_fmtV(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v) + "M"

// draws one set of levels: band (and/or line) per level, colour by sign, brightness by |value|
f_draw(array<float> ps, array<float> vs, array<string> names, color cPos, color cNeg, float half, string style) =>
    float m = 0.0
    for v in vs
        m := math.max(m, math.abs(v))
    if array.size(ps) > 0
        for i = 0 to array.size(ps) - 1
            p = array.get(ps, i)
            v = array.get(vs, i)
            rel = m > 0 ? math.abs(v) / m : 0.5
            col = v < 0 ? cNeg : cPos
            t = math.round(maxAlpha - rel * (maxAlpha - minAlpha))
            if style != "خطوط"
                if glow
                    f_band(p, half * 2.2, col, math.min(97, t + 12))
                f_band(p, half, col, t)
            if style != "هيت ماب"
                f_line(p, color.new(col, math.round((1 - rel) * 55)), math.max(1, math.round(rel * 5)), false)
            if showTxt
                nm = array.get(names, i)
                f_tag(p, col, (str.length(nm) > 0 ? nm + "  " : "") + str.tostring(p) + (v != 0 ? "  " + f_fmtV(v) : ""))

f_add(array<float> ps, array<float> vs, array<string> ns, float p, float v, string n) =>
    // ignore empty boxes and levels more than 30% away from price (e.g. typed in another company's section)
    if p > 0 and math.abs(p / close - 1) < 0.3
        array.push(ps, p)
        array.push(vs, v)
        array.push(ns, n)

// which company is on the chart?
f_active() =>
    t = str.upper(syminfo.ticker)
    string a = ""
    for x in str.split(str.upper(str.replace_all(spxAlias, " ", "")), ",")
        if x == t
            a := "SPX"
    if a == ""
        a := t == "GOOG" ? "GOOGL" : t
    a

if barstate.islast
    f_clearAll()
    half = bandAuto ? close * 0.0004 : bandPts
    act = f_active()
    dps = array.new<float>()
    dvs = array.new<float>()
    dns = array.new<string>()
