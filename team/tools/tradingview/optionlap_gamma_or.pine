//@version=6
// OptionLap · Gamma + Delta heatmap + Opening Range + IB + daily Volume Profile  (v5.2, form inputs, one copy per symbol)
// Each level = a price box and, right under it, a value box ($M).
//   Negative value → brown, positive value → fluorescent. Stronger value → brighter band.
// Per symbol: add the indicator once per company and type its ticker in "الشركة". Each copy draws only on its own
//   chart, so switching TSLA → NVDA hides TSLA's levels, and going back to TSLA shows them again.
// Numbers: MenthorQ, or python3 team/tools/gex.py _SPX next --pine. For education only, not a recommendation.
indicator("OptionLap · Gamma + Delta + OR", shorttitle="OL Gamma", overlay=true, max_lines_count=300, max_labels_count=150, max_boxes_count=500)

// ───────── الشركة ─────────
grpX = "الشركة"
symKey = input.string("", "الشركة (مثل TSLA)", group=grpX, tooltip="اكتب رمز الشركة. اللفلات ترسم بس على شارتها، وتختفي إذا فتحت شركة ثانية، وترجع إذا رجعت لها.\nضيف المؤشر مرة لكل شركة. لو تركته فاضي يرسم على أي شارت.")

// ───────── القاما: 7 لفلات (السعر، وتحته القيمة) ─────────
grpG = "القاما (السعر، وتحته القيمة بالمليون)"
cwP = input.float(0.0, "جدار الكول: السعر", group=grpG)
cwV = input.float(0.0, "القيمة", group=grpG)
pwP = input.float(0.0, "جدار البوت: السعر", group=grpG)
pwV = input.float(0.0, "القيمة", group=grpG)
zgP = input.float(0.0, "الزيرو قاما: السعر", group=grpG)
zgV = input.float(0.0, "القيمة", group=grpG)
g1P = input.float(0.0, "منطقة 1: السعر", group=grpG)
g1V = input.float(0.0, "القيمة", group=grpG)
g2P = input.float(0.0, "منطقة 2: السعر", group=grpG)
g2V = input.float(0.0, "القيمة", group=grpG)
g3P = input.float(0.0, "منطقة 3: السعر", group=grpG)
g3V = input.float(0.0, "القيمة", group=grpG)
g4P = input.float(0.0, "منطقة 4: السعر", group=grpG)
g4V = input.float(0.0, "القيمة", group=grpG)

// ───────── الدلتا: 7 لفلات (السعر، وتحته القيمة) ─────────
grpD = "الدلتا (السعر، وتحته القيمة بالمليون)"
d1P = input.float(0.0, "دلتا 1: السعر", group=grpD)
d1V = input.float(0.0, "القيمة", group=grpD)
d2P = input.float(0.0, "دلتا 2: السعر", group=grpD)
d2V = input.float(0.0, "القيمة", group=grpD)
d3P = input.float(0.0, "دلتا 3: السعر", group=grpD)
d3V = input.float(0.0, "القيمة", group=grpD)
d4P = input.float(0.0, "دلتا 4: السعر", group=grpD)
d4V = input.float(0.0, "القيمة", group=grpD)
d5P = input.float(0.0, "دلتا 5: السعر", group=grpD)
d5V = input.float(0.0, "القيمة", group=grpD)
d6P = input.float(0.0, "دلتا 6: السعر", group=grpD)
d6V = input.float(0.0, "القيمة", group=grpD)
d7P = input.float(0.0, "دلتا 7: السعر", group=grpD)
d7V = input.float(0.0, "القيمة", group=grpD)

// ───────── الشكل والألوان ─────────
grpC = "الشكل والألوان"
gStyle   = input.string("هيت ماب", "شكل القاما", options=["هيت ماب", "خطوط", "الاثنين"], group=grpC)
showG    = input.bool(true, "اعرض القاما", group=grpC)
showD    = input.bool(true, "اعرض الدلتا", group=grpC)
showTxt  = input.bool(true, "اكتب الاسم والقيمة جنب المستوى", group=grpC)
colGPos  = input.color(#2EF2C8, "قاما موجبة", group=grpC)
colGNeg  = input.color(#C98A6A, "قاما سالبة", group=grpC)
colDPos  = input.color(#2EF2C8, "دلتا موجبة", group=grpC)
colDNeg  = input.color(#C98A6A, "دلتا سالبة", group=grpC)
colZero  = input.color(#FFC21A, "خط الزيرو قاما", group=grpC)
colBrkUp = input.color(#00E58A, "سهم كسر الـIB فوق", group=grpC)
colBrkDn = input.color(#FF3B47, "سهم كسر الـIB تحت", group=grpC)
bandAuto = input.bool(true, "سماكة تلقائية (0.04% من السعر)", group=grpC)
bandPts  = input.float(2.5, "سماكة يدوية (نقاط فوق وتحت)", minval=0.01, step=0.25, group=grpC)
glow     = input.bool(true, "توهّج حول الشريط", group=grpC)
minAlpha = input.int(15, "أقوى مستوى: شفافية %", minval=0, maxval=90, group=grpC)
maxAlpha = input.int(85, "أضعف مستوى: شفافية %", minval=10, maxval=98, group=grpC)

// ───────── الأوبن رينج والـIB ─────────
grpS = "الأوبن رينج والـIB (توقيت نيويورك)"
tz      = input.string("America/New_York", "المنطقة الزمنية", group=grpS)
orSess  = input.session("0930-0945", "الأوبن رينج", group=grpS, tooltip="0930-0935 = 5 دقايق، 0930-0945 = 15، 0930-1000 = 30")
ibSess  = input.session("0930-1030", "الـIB (أول ساعة)", group=grpS)
showOR  = input.bool(true, "اعرض الأوبن رينج", group=grpS)
showIB  = input.bool(true, "اعرض الـIB", group=grpS)
showBrk = input.bool(true, "علّم أول كسر للـIB (إغلاق برّا)", group=grpS)
colOR   = input.color(#9B6BFF, "لون الأوبن رينج", group=grpS)
colIB   = input.color(#8E99A6, "لون الـIB", group=grpS)

// ───────── أدوات الرسم ─────────
var array<line>  gLines  = array.new<line>()
var array<label> gLabels = array.new<label>()
var array<box>   gBoxes  = array.new<box>()

f_clearAll() =>
    for l in gLines
        line.delete(l)
    for b in gLabels
        label.delete(b)
    for x in gBoxes
        box.delete(x)
    array.clear(gLines)
    array.clear(gLabels)
    array.clear(gBoxes)

f_line(float price, color col, int w, bool dashed) =>
    array.push(gLines, line.new(bar_index - 1, price, bar_index, price, extend=extend.both, color=col, width=w, style=dashed ? line.style_dashed : line.style_solid))

f_tag(float price, color col, string txt) =>
    array.push(gLabels, label.new(bar_index + 3, price, txt, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small))

f_band(float price, float half, color col, int transp) =>
    array.push(gBoxes, box.new(bar_index - 1, price + half, bar_index, price - half, border_color=color.new(col, 100), bgcolor=color.new(col, transp), extend=extend.both))

f_fmtV(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v) + "M"

// draws one set of levels: band (and/or line) per level, colour by sign, brightness by |value|
f_draw(array<float> ps, array<float> vs, array<string> names, color cPos, color cNeg, float half, string style) =>
    float m = 0.0
    for v in vs
        m := math.max(m, math.abs(v))
    if array.size(ps) > 0
        for i = 0 to array.size(ps) - 1
            p = array.get(ps, i)
            v = array.get(vs, i)
            rel = m > 0 ? math.abs(v) / m : 0.5
            col = v < 0 ? cNeg : cPos
            t = math.round(maxAlpha - rel * (maxAlpha - minAlpha))
            if style != "خطوط"
                if glow
                    f_band(p, half * 2.2, col, math.min(97, t + 12))
                f_band(p, half, col, t)
            if style != "هيت ماب"
                f_line(p, color.new(col, math.round((1 - rel) * 55)), math.max(1, math.round(rel * 5)), false)
            if showTxt
                nm = array.get(names, i)
                f_tag(p, col, (str.length(nm) > 0 ? nm + "  " : "") + str.tostring(p) + (v != 0 ? "  " + f_fmtV(v) : ""))

f_add(array<float> ps, array<float> vs, array<string> ns, float p, float v, string n) =>
    if p > 0
        array.push(ps, p)
        array.push(vs, v)
        array.push(ns, n)

// does this copy belong to the chart that is open now?  ("NASDAQ:TSLA" or "tsla" both work)
f_mine() =>
    k = str.upper(str.replace_all(symKey, " ", ""))
    parts = str.split(k, ":")
    k2 = array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : k
    str.length(k2) == 0 or k2 == str.upper(syminfo.ticker)

if barstate.islast
    f_clearAll()
    half = bandAuto ? close * 0.0004 : bandPts
    mine = f_mine()
    if mine and showD
        dps = array.new<float>()
        dvs = array.new<float>()
        dns = array.new<string>()
        f_add(dps, dvs, dns, d1P, d1V, "Δ")
        f_add(dps, dvs, dns, d2P, d2V, "Δ")
        f_add(dps, dvs, dns, d3P, d3V, "Δ")
        f_add(dps, dvs, dns, d4P, d4V, "Δ")
        f_add(dps, dvs, dns, d5P, d5V, "Δ")
        f_add(dps, dvs, dns, d6P, d6V, "Δ")
        f_add(dps, dvs, dns, d7P, d7V, "Δ")
        f_draw(dps, dvs, dns, colDPos, colDNeg, half, "هيت ماب")
    if mine and showG
        gps = array.new<float>()
        gvs = array.new<float>()
        gns = array.new<string>()
        f_add(gps, gvs, gns, cwP, cwV, "جدار الكول")
        f_add(gps, gvs, gns, pwP, pwV, "جدار البوت")
        f_add(gps, gvs, gns, zgP, zgV, "زيرو قاما")
        f_add(gps, gvs, gns, g1P, g1V, "")
        f_add(gps, gvs, gns, g2P, g2V, "")
        f_add(gps, gvs, gns, g3P, g3V, "")
        f_add(gps, gvs, gns, g4P, g4V, "")
        f_draw(gps, gvs, gns, colGPos, colGNeg, half * 0.7, gStyle)
        if zgP > 0
            f_line(zgP, colZero, 2, true)

// ───────── الأوبن رينج والـIB (لكل يوم) ─────────
inOR = not na(time(timeframe.period, orSess, tz))
inIB = not na(time(timeframe.period, ibSess, tz))
newDay = ta.change(time("D", "", tz)) != 0

var float orH = na
var float orL = na
var float ibH = na
var float ibL = na
var bool  brkDone = false
if newDay
    orH := na
    orL := na
    ibH := na
    ibL := na
    brkDone := false
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
if inIB
    ibH := na(ibH) ? high : math.max(ibH, high)
    ibL := na(ibL) ? low : math.min(ibL, low)

orDone = not inOR and not na(orH)
ibDone = not inIB and not na(ibH)
plot(showOR and orDone ? orH : na, "OR High", colOR, 2, plot.style_linebr)
plot(showOR and orDone ? orL : na, "OR Low", colOR, 2, plot.style_linebr)
plot(showIB and ibDone ? ibH : na, "IB High", colIB, 1, plot.style_linebr)
plot(showIB and ibDone ? ibL : na, "IB Low", colIB, 1, plot.style_linebr)

brkUp = showBrk and ibDone and not brkDone and close > ibH
brkDn = showBrk and ibDone and not brkDone and close < ibL
if brkUp or brkDn
    brkDone := true
plotshape(brkUp, "IB break up", shape.triangleup, location.belowbar, colBrkUp, size=size.small, text="IB↑")
plotshape(brkDn, "IB break down", shape.triangledown, location.abovebar, colBrkDn, size=size.small, text="IB↓")
alertcondition(brkUp, "OL: IB break up", "كسر الـIB فوق (إغلاق شمعة)")
alertcondition(brkDn, "OL: IB break down", "كسر الـIB تحت (إغلاق شمعة)")

// ───────── فوليوم بروفايل يومي (لكل جلسة لحالها) ─────────
grpV = "الفوليوم بروفايل اليومي"
showVP  = input.bool(true, "اعرض بروفايل كل يوم", group=grpV, tooltip="مؤشر SPX ما له حجم في TradingView. استخدم ES1! أو SPY، والأسهم عادي.")
rthSess = input.session("0930-1600", "الجلسة", group=grpV)
vpPct   = input.float(0.05, "حجم الخانة % من السعر", minval=0.005, step=0.005, group=grpV, tooltip="0.05% = حوالي 3.75 نقطة لسباكس، و0.17$ لسهم 350$")
vpWidth = input.int(35, "عرض البروفايل % من اليوم", minval=5, maxval=100, group=grpV)
vpDays  = input.int(5, "كم يوم يبقى على الشارت", minval=1, maxval=10, group=grpV)
vpVA    = input.int(70, "منطقة القيمة %", minval=50, maxval=90, group=grpV)
colVPin = input.color(color.new(#8E99A6, 55), "داخل القيمة", group=grpV)
colVPout= input.color(color.new(#8E99A6, 80), "برّا القيمة", group=grpV)
colPOC  = input.color(#FFC21A, "POC", group=grpV)
colVAL  = input.color(color.new(#9B6BFF, 0), "VAH و VAL", group=grpV)

N_BINS = 400
var array<float> vVol   = array.new<float>(N_BINS, 0.0)
var float vBase = na
var float vBin  = na
var int   vStart = na
var int   vEnd   = na
TF_MS = timeframe.in_seconds() * 1000
var int   vMinI  = N_BINS
var int   vMaxI  = -1
var array<box>  vpHist  = array.new<box>()
var array<line> vpHistL = array.new<line>()
var array<box>  vpLive  = array.new<box>()
var array<line> vpLiveL = array.new<line>()

inRTH = not na(time(timeframe.period, rthSess, tz))
rthStart = inRTH and (not inRTH[1] or newDay)

// draws the profile currently held in vVol into the given arrays (x in bar TIME, so old days never break the drawing limit)
f_vpDraw(array<box> bx, array<line> ln, int xEnd) =>
    if vMaxI >= vMinI and not na(vStart)
        float tot = 0.0
        int poc = vMinI
        for i = vMinI to vMaxI
            v = array.get(vVol, i)
            tot += v
            if v > array.get(vVol, poc)
                poc := i
        if tot > 0
            // value area: grow from POC toward the heavier side
            int lo = poc
            int hi = poc
            float acc = array.get(vVol, poc)
            while acc < tot * vpVA / 100.0 and (lo > vMinI or hi < vMaxI)
                float up = hi < vMaxI ? array.get(vVol, hi + 1) : -1.0
                float dn = lo > vMinI ? array.get(vVol, lo - 1) : -1.0
                if up >= dn
                    hi += 1
                    acc += up
                else
                    lo -= 1
                    acc += dn
            maxV = array.get(vVol, poc)
            span = math.max(1, (xEnd - vStart) / TF_MS)
            for i = vMinI to vMaxI
                v = array.get(vVol, i)
                if v > 0
                    w = math.max(1, math.round(v / maxV * span * vpWidth / 100.0))
                    top = vBase + (i + 1) * vBin
                    bot = vBase + i * vBin
                    c = i == poc ? color.new(colPOC, 30) : (i >= lo and i <= hi ? colVPin : colVPout)
                    array.push(bx, box.new(vStart, top, vStart + w * TF_MS, bot, xloc=xloc.bar_time, border_color=color.new(c, 100), bgcolor=c))
            pocP = vBase + (poc + 0.5) * vBin
            vahP = vBase + (hi + 1) * vBin
            valP = vBase + lo * vBin
            array.push(ln, line.new(vStart, pocP, xEnd, pocP, xloc=xloc.bar_time, color=colPOC, width=2))
            array.push(ln, line.new(vStart, vahP, xEnd, vahP, xloc=xloc.bar_time, color=colVAL, width=1, style=line.style_dashed))
            array.push(ln, line.new(vStart, valP, xEnd, valP, xloc=xloc.bar_time, color=colVAL, width=1, style=line.style_dashed))

if showVP
    // a new session: freeze yesterday's profile, then reset
    if rthStart
        if not na(vStart)
            f_vpDraw(vpHist, vpHistL, vEnd)
            // keep only the last N days (about 3 lines per day)
            while array.size(vpHistL) > vpDays * 3
                line.delete(array.shift(vpHistL))
            while array.size(vpHist) > 330
                box.delete(array.shift(vpHist))
        array.fill(vVol, 0.0)
        vBin := math.max(syminfo.mintick, close * vpPct / 100.0)
        vBase := open - (N_BINS / 2) * vBin
        vStart := time
        vMinI := N_BINS
        vMaxI := -1
    if inRTH and not na(vBase)
        vEnd := time
        iLo = math.max(0, math.min(N_BINS - 1, int(math.floor((low - vBase) / vBin))))
        iHi = math.max(0, math.min(N_BINS - 1, int(math.floor((high - vBase) / vBin))))
        n = iHi - iLo + 1
        vol = nz(volume)
        for i = iLo to iHi
            array.set(vVol, i, array.get(vVol, i) + vol / n)
        vMinI := math.min(vMinI, iLo)
        vMaxI := math.max(vMaxI, iHi)
    // today's profile, redrawn live on the last bar
    if barstate.islast
        for b in vpLive
            box.delete(b)
        for l in vpLiveL
            line.delete(l)
        array.clear(vpLive)
        array.clear(vpLiveL)
        f_vpDraw(vpLive, vpLiveL, time)
