// ───────── الأوبن رينج والـIB (لكل يوم) ─────────
inOR = not na(time(timeframe.period, orSess, tz))
inIB = not na(time(timeframe.period, ibSess, tz))
newDay = ta.change(time("D", "", tz)) != 0

var float orH = na
var float orL = na
var float ibH = na
var float ibL = na
var bool  brkDone = false
if newDay
    orH := na
    orL := na
    ibH := na
    ibL := na
    brkDone := false
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
if inIB
    ibH := na(ibH) ? high : math.max(ibH, high)
    ibL := na(ibL) ? low : math.min(ibL, low)

orDone = not inOR and not na(orH)
ibDone = not inIB and not na(ibH)
plot(showOR and orDone ? orH : na, "OR High", colOR, 2, plot.style_linebr)
plot(showOR and orDone ? orL : na, "OR Low", colOR, 2, plot.style_linebr)
plot(showIB and ibDone ? ibH : na, "IB High", colIB, 1, plot.style_linebr)
plot(showIB and ibDone ? ibL : na, "IB Low", colIB, 1, plot.style_linebr)

brkUp = showBrk and ibDone and not brkDone and close > ibH
brkDn = showBrk and ibDone and not brkDone and close < ibL
if brkUp or brkDn
    brkDone := true
plotshape(brkUp, "IB break up", shape.triangleup, location.belowbar, colBrkUp, size=size.small, text="IB↑")
plotshape(brkDn, "IB break down", shape.triangledown, location.abovebar, colBrkDn, size=size.small, text="IB↓")
alertcondition(brkUp, "OL: IB break up", "كسر الـIB فوق (إغلاق شمعة)")
alertcondition(brkDn, "OL: IB break down", "كسر الـIB تحت (إغلاق شمعة)")

// ───────── فوليوم بروفايل يومي (لكل جلسة لحالها) ─────────
grpV = "الفوليوم بروفايل اليومي"
showVP  = input.bool(true, "اعرض بروفايل كل يوم", group=grpV, tooltip="مؤشر SPX ما له حجم في TradingView. استخدم ES1! أو SPY، والأسهم عادي.")
rthSess = input.session("0930-1600", "الجلسة", group=grpV)
vpPct   = input.float(0.05, "حجم الخانة % من السعر", minval=0.005, step=0.005, group=grpV, tooltip="0.05% = حوالي 3.75 نقطة لسباكس، و0.17$ لسهم 350$")
vpWidth = input.int(35, "عرض البروفايل % من اليوم", minval=5, maxval=100, group=grpV)
vpDays  = input.int(5, "كم يوم يبقى على الشارت", minval=1, maxval=10, group=grpV)
vpVA    = input.int(70, "منطقة القيمة %", minval=50, maxval=90, group=grpV)
colVPin = input.color(color.new(#8E99A6, 55), "داخل القيمة", group=grpV)
colVPout= input.color(color.new(#8E99A6, 80), "برّا القيمة", group=grpV)
colPOC  = input.color(#FFC21A, "POC", group=grpV)
colVAL  = input.color(color.new(#9B6BFF, 0), "VAH و VAL", group=grpV)

N_BINS = 400
var array<float> vVol   = array.new<float>(N_BINS, 0.0)
var float vBase = na
var float vBin  = na
var int   vStart = na
var int   vEnd   = na
TF_MS = timeframe.in_seconds() * 1000
var int   vMinI  = N_BINS
var int   vMaxI  = -1
var array<box>  vpHist  = array.new<box>()
var array<line> vpHistL = array.new<line>()
var array<box>  vpLive  = array.new<box>()
var array<line> vpLiveL = array.new<line>()

inRTH = not na(time(timeframe.period, rthSess, tz))
rthStart = inRTH and (not inRTH[1] or newDay)

// draws the profile currently held in vVol into the given arrays (x in bar TIME, so old days never break the drawing limit)
f_vpDraw(array<box> bx, array<line> ln, int xEnd) =>
    if vMaxI >= vMinI and not na(vStart)
        float tot = 0.0
        int poc = vMinI
        for i = vMinI to vMaxI
            v = array.get(vVol, i)
            tot += v
            if v > array.get(vVol, poc)
                poc := i
        if tot > 0
            // value area: grow from POC toward the heavier side
            int lo = poc
            int hi = poc
            float acc = array.get(vVol, poc)
            while acc < tot * vpVA / 100.0 and (lo > vMinI or hi < vMaxI)
                float up = hi < vMaxI ? array.get(vVol, hi + 1) : -1.0
                float dn = lo > vMinI ? array.get(vVol, lo - 1) : -1.0
                if up >= dn
                    hi += 1
                    acc += up
                else
                    lo -= 1
                    acc += dn
            maxV = array.get(vVol, poc)
            span = math.max(1, (xEnd - vStart) / TF_MS)
            for i = vMinI to vMaxI
                v = array.get(vVol, i)
                if v > 0
                    w = math.max(1, math.round(v / maxV * span * vpWidth / 100.0))
                    top = vBase + (i + 1) * vBin
                    bot = vBase + i * vBin
                    c = i == poc ? color.new(colPOC, 30) : (i >= lo and i <= hi ? colVPin : colVPout)
                    array.push(bx, box.new(vStart, top, vStart + w * TF_MS, bot, xloc=xloc.bar_time, border_color=color.new(c, 100), bgcolor=c))
            pocP = vBase + (poc + 0.5) * vBin
            vahP = vBase + (hi + 1) * vBin
            valP = vBase + lo * vBin
            array.push(ln, line.new(vStart, pocP, xEnd, pocP, xloc=xloc.bar_time, color=colPOC, width=2))
            array.push(ln, line.new(vStart, vahP, xEnd, vahP, xloc=xloc.bar_time, color=colVAL, width=1, style=line.style_dashed))
            array.push(ln, line.new(vStart, valP, xEnd, valP, xloc=xloc.bar_time, color=colVAL, width=1, style=line.style_dashed))

if showVP
    // a new session: freeze yesterday's profile, then reset
    if rthStart
        if not na(vStart)
            f_vpDraw(vpHist, vpHistL, vEnd)
            // keep only the last N days (about 3 lines per day)
            while array.size(vpHistL) > vpDays * 3
                line.delete(array.shift(vpHistL))
            while array.size(vpHist) > 330
                box.delete(array.shift(vpHist))
        array.fill(vVol, 0.0)
        vBin := math.max(syminfo.mintick, close * vpPct / 100.0)
        vBase := open - (N_BINS / 2) * vBin
        vStart := time
        vMinI := N_BINS
        vMaxI := -1
    if inRTH and not na(vBase)
        vEnd := time
        iLo = math.max(0, math.min(N_BINS - 1, int(math.floor((low - vBase) / vBin))))
        iHi = math.max(0, math.min(N_BINS - 1, int(math.floor((high - vBase) / vBin))))
        n = iHi - iLo + 1
        vol = nz(volume)
        for i = iLo to iHi
            array.set(vVol, i, array.get(vVol, i) + vol / n)
        vMinI := math.min(vMinI, iLo)
        vMaxI := math.max(vMaxI, iHi)
    // today's profile, redrawn live on the last bar
    if barstate.islast
        for b in vpLive
            box.delete(b)
        for l in vpLiveL
            line.delete(l)
        array.clear(vpLive)
        array.clear(vpLiveL)
        f_vpDraw(vpLive, vpLiveL, time)
