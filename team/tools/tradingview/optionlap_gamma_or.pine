//@version=6
// OptionLap · Gamma + Delta heatmap + Opening Range + IB  (v4, multi-symbol + daily volume profile)
// One line per symbol in the box:   TICKER | gamma strike:$M,... | delta strike:$M,...
// The indicator picks the line that matches the chart's ticker, so one indicator serves SPX, AAPL, NVDA...
// Daily lines: python3 team/tools/gex.py _SPX next --pine   (or AAPL, NVDA, ...), or MenthorQ numbers by hand.
// For education only, not a recommendation.
indicator("OptionLap · Gamma + Delta + OR", shorttitle="OL Gamma", overlay=true, max_lines_count=300, max_labels_count=150, max_boxes_count=500)

// ───────── البيانات (سطر لكل شركة) ─────────
grpL = "اللفلات: سطر لكل شركة"
data = input.text_area("SPX | 7650:1098,7605:1435,7600:1498,7590:965,7585:988,7580:678,7575:1338,7550:939,7520:-891,7510:-753 | 7670:-782,7605:775,7600:832,7585:859,7580:904,7575:1524,7550:2086,7450:782,7430:1071,7400:1021\nAAPL | 355:126,352.5:28,350:21,347.5:-45,345:-22 | 355:43,347.5:-56,342.5:-11", "الرمز | القاما | الدلتا", group=grpL, tooltip="كل سطر: الرمز | سعر:قيمة,سعر:قيمة | سعر:قيمة\nالقيمة بالمليون دولار، والموجب والسالب مهم.\nتضيف لفل جديد: حط فاصلة وبعدها سعر:قيمة، مثل ,7700:500\nتضيف شركة: سطر جديد بنفس الشكل.")
alias  = input.string("", "رمز بديل (اختياري)", group=grpL, tooltip="لو الشارت رمزه غير السطر (مثل ES1! وتبي لفلات SPX)، اكتب هنا SPX")
offset = input.float(0.0, "إزاحة السعر", group=grpL, tooltip="للفيوتشر: فرق ES عن SPX (مثلاً +35). تنضاف لكل اللفلات.")

// ───────── القاما ─────────
grpG = "القاما"
gStyle   = input.string("هيت ماب", "شكل القاما", options=["هيت ماب", "خطوط", "الاثنين"], group=grpG)
zeroG    = input.float(0.0, "الزيرو قاما (0 = بدون)", group=grpG)
callWall = input.float(0.0, "جدار الكول (0 = بدون)", group=grpG)
putWall  = input.float(0.0, "جدار البوت (0 = بدون)", group=grpG)
showGTxt = input.bool(true, "اكتب القيمة جنب المستوى", group=grpG)
colGPos  = input.color(#FF3B47, "قاما موجبة", group=grpG)
colGNeg  = input.color(#00E58A, "قاما سالبة", group=grpG)
colZero  = input.color(#FFC21A, "زيرو قاما", group=grpG)

// ───────── الدلتا ─────────
grpD = "الدلتا"
showD    = input.bool(true, "اعرض هيت ماب الدلتا", group=grpD)
showDTxt = input.bool(false, "اكتب قيمة الدلتا", group=grpD)
colDPos  = input.color(#2EF2C8, "دلتا موجبة (فسفوري)", group=grpD)
colDNeg  = input.color(#C98A6A, "دلتا سالبة (بني)", group=grpD)

// ───────── شكل الهيت ماب ─────────
grpH = "الهيت ماب"
bandAuto = input.bool(true, "سماكة تلقائية (0.04% من السعر)", group=grpH)
bandPts  = input.float(2.5, "سماكة يدوية (نقاط فوق وتحت)", minval=0.01, step=0.25, group=grpH)
glow     = input.bool(true, "توهّج حول الشريط", group=grpH)
minAlpha = input.int(15, "أقوى مستوى: شفافية %", minval=0, maxval=90, group=grpH)
maxAlpha = input.int(85, "أضعف مستوى: شفافية %", minval=10, maxval=98, group=grpH)

// ───────── الأوبن رينج والـIB ─────────
grpS = "الأوبن رينج والـIB (توقيت نيويورك)"
tz      = input.string("America/New_York", "المنطقة الزمنية", group=grpS)
orSess  = input.session("0930-0945", "الأوبن رينج", group=grpS, tooltip="0930-0935 = 5 دقايق، 0930-0945 = 15، 0930-1000 = 30")
ibSess  = input.session("0930-1030", "الـIB (أول ساعة)", group=grpS)
showOR  = input.bool(true, "اعرض الأوبن رينج", group=grpS)
showIB  = input.bool(true, "اعرض الـIB", group=grpS)
showBrk = input.bool(true, "علّم أول كسر للـIB (إغلاق برّا)", group=grpS)
colOR   = input.color(#9B6BFF, "لون الأوبن رينج", group=grpS)
colIB   = input.color(#8E99A6, "لون الـIB", group=grpS)

// ───────── أدوات ─────────
var array<line>  gLines  = array.new<line>()
var array<label> gLabels = array.new<label>()
var array<box>   gBoxes  = array.new<box>()

f_clearAll() =>
    for l in gLines
        line.delete(l)
    for b in gLabels
        label.delete(b)
    for x in gBoxes
        box.delete(x)
    array.clear(gLines)
    array.clear(gLabels)
    array.clear(gBoxes)

// "7550:990,7520:-975" → keys / values (offset added to keys)
f_parse(string s, float off) =>
    ks = array.new<float>()
    vs = array.new<float>()
    for p in str.split(s, ",")
        kv = str.split(str.replace_all(p, " ", ""), ":")
        if array.size(kv) == 2
            k = str.tonumber(array.get(kv, 0))
            v = str.tonumber(array.get(kv, 1))
            if not na(k) and not na(v)
                array.push(ks, k + off)
                array.push(vs, v)
    [ks, vs]

f_maxAbs(array<float> vs) =>
    float m = 0.0
    for v in vs
        m := math.max(m, math.abs(v))
    m

f_line(float price, color col, int w, bool dashed) =>
    array.push(gLines, line.new(bar_index - 1, price, bar_index, price, extend=extend.both, color=col, width=w, style=dashed ? line.style_dashed : line.style_solid))

f_tag(float price, color col, string txt) =>
    array.push(gLabels, label.new(bar_index + 3, price, txt, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small))

f_band(float price, float half, color col, int transp) =>
    array.push(gBoxes, box.new(bar_index - 1, price + half, bar_index, price - half, border_color=color.new(col, 100), bgcolor=color.new(col, transp), extend=extend.both))

// heatmap rows for one set of levels
f_heat(array<float> ks, array<float> vs, color cPos, color cNeg, float half) =>
    m = f_maxAbs(vs)
    if m > 0 and array.size(ks) > 0
        for i = 0 to array.size(ks) - 1
            rel = math.abs(array.get(vs, i)) / m
            t = math.round(maxAlpha - rel * (maxAlpha - minAlpha))
            col = array.get(vs, i) >= 0 ? cPos : cNeg
            if glow
                f_band(array.get(ks, i), half * 2.2, col, math.min(97, t + 12))
            f_band(array.get(ks, i), half, col, t)

f_fmt(float k, float v) =>
    str.tostring(k) + "  " + (v >= 0 ? "+" : "") + str.tostring(v) + "M"

// ───────── اختيار سطر الشركة ─────────
f_pick(string txt, string want) =>
    string g = ""
    string d = ""
    bool found = false
    for row in str.split(txt, "\n")
        cols = str.split(row, "|")
        if array.size(cols) >= 2 and not found
            name = str.upper(str.replace_all(array.get(cols, 0), " ", ""))
            if name == want
                found := true
                g := array.get(cols, 1)
                d := array.size(cols) >= 3 ? array.get(cols, 2) : ""
    [found, g, d]

if barstate.islast
    f_clearAll()
    want = str.upper(str.length(alias) > 0 ? alias : syminfo.ticker)
    [found, gTxt, dTxt] = f_pick(data, want)
    half = bandAuto ? close * 0.0004 : bandPts
    if not found
        f_tag(close, color.gray, "ما فيه سطر للرمز " + want + " في خانة اللفلات")
    else
        [gk, gv] = f_parse(gTxt, offset)
        [dk, dv] = f_parse(dTxt, offset)
        // الدلتا أول (تحت)، بعدها القاما
        if showD
            f_heat(dk, dv, colDPos, colDNeg, half)
            if showDTxt and array.size(dk) > 0
                for i = 0 to array.size(dk) - 1
                    f_tag(array.get(dk, i), array.get(dv, i) >= 0 ? colDPos : colDNeg, "Δ " + f_fmt(array.get(dk, i), array.get(dv, i)))
        gm = f_maxAbs(gv)
        if gm > 0
            if gStyle != "خطوط"
                f_heat(gk, gv, colGPos, colGNeg, half * 0.7)
            for i = 0 to array.size(gk) - 1
                k = array.get(gk, i)
                v = array.get(gv, i)
                rel = math.abs(v) / gm
                col = v >= 0 ? colGPos : colGNeg
                if gStyle != "هيت ماب"
                    f_line(k, color.new(col, math.round((1 - rel) * 55)), math.max(1, math.round(rel * 5)), false)
                if showGTxt
                    f_tag(k, col, "Γ " + f_fmt(k, v))
    if zeroG > 0
        f_line(zeroG + offset, colZero, 2, true)
        f_tag(zeroG + offset, colZero, "زيرو قاما " + str.tostring(zeroG))
    if callWall > 0
        f_line(callWall + offset, colGPos, 4, false)
        f_tag(callWall + offset, colGPos, "جدار الكول " + str.tostring(callWall))
    if putWall > 0
        f_line(putWall + offset, colGNeg, 4, false)
        f_tag(putWall + offset, colGNeg, "جدار البوت " + str.tostring(putWall))

// ───────── الأوبن رينج والـIB (لكل يوم) ─────────
inOR = not na(time(timeframe.period, orSess, tz))
inIB = not na(time(timeframe.period, ibSess, tz))
newDay = ta.change(time("D", "", tz)) != 0

var float orH = na
var float orL = na
var float ibH = na
var float ibL = na
var bool  brkDone = false
if newDay
    orH := na
    orL := na
    ibH := na
    ibL := na
    brkDone := false
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
if inIB
    ibH := na(ibH) ? high : math.max(ibH, high)
    ibL := na(ibL) ? low : math.min(ibL, low)

orDone = not inOR and not na(orH)
ibDone = not inIB and not na(ibH)
plot(showOR and orDone ? orH : na, "OR High", colOR, 2, plot.style_linebr)
plot(showOR and orDone ? orL : na, "OR Low", colOR, 2, plot.style_linebr)
plot(showIB and ibDone ? ibH : na, "IB High", colIB, 1, plot.style_linebr)
plot(showIB and ibDone ? ibL : na, "IB Low", colIB, 1, plot.style_linebr)

brkUp = showBrk and ibDone and not brkDone and close > ibH
brkDn = showBrk and ibDone and not brkDone and close < ibL
if brkUp or brkDn
    brkDone := true
plotshape(brkUp, "IB break up", shape.triangleup, location.belowbar, colGNeg, size=size.small, text="IB↑")
plotshape(brkDn, "IB break down", shape.triangledown, location.abovebar, colGPos, size=size.small, text="IB↓")
alertcondition(brkUp, "OL: IB break up", "كسر الـIB فوق (إغلاق شمعة)")
alertcondition(brkDn, "OL: IB break down", "كسر الـIB تحت (إغلاق شمعة)")

// ───────── فوليوم بروفايل يومي (لكل جلسة لحالها) ─────────
grpV = "الفوليوم بروفايل اليومي"
showVP  = input.bool(true, "اعرض بروفايل كل يوم", group=grpV, tooltip="مؤشر SPX ما له حجم في TradingView. استخدم ES1! أو SPY، والأسهم عادي.")
rthSess = input.session("0930-1600", "الجلسة", group=grpV)
vpPct   = input.float(0.05, "حجم الخانة % من السعر", minval=0.005, step=0.005, group=grpV, tooltip="0.05% = حوالي 3.75 نقطة لسباكس، و0.17$ لسهم 350$")
vpWidth = input.int(35, "عرض البروفايل % من اليوم", minval=5, maxval=100, group=grpV)
vpDays  = input.int(5, "كم يوم يبقى على الشارت", minval=1, maxval=10, group=grpV)
vpVA    = input.int(70, "منطقة القيمة %", minval=50, maxval=90, group=grpV)
colVPin = input.color(color.new(#8E99A6, 55), "داخل القيمة", group=grpV)
colVPout= input.color(color.new(#8E99A6, 80), "برّا القيمة", group=grpV)
colPOC  = input.color(#FFC21A, "POC", group=grpV)
colVAL  = input.color(color.new(#9B6BFF, 0), "VAH و VAL", group=grpV)

N_BINS = 400
var array<float> vVol   = array.new<float>(N_BINS, 0.0)
var float vBase = na
var float vBin  = na
var int   vStart = na
var int   vEnd   = na
var int   vMinI  = N_BINS
var int   vMaxI  = -1
var array<box>  vpHist  = array.new<box>()
var array<line> vpHistL = array.new<line>()
var array<box>  vpLive  = array.new<box>()
var array<line> vpLiveL = array.new<line>()

inRTH = not na(time(timeframe.period, rthSess, tz))
rthStart = inRTH and not inRTH[1]

// draws the profile currently held in vVol into the given arrays; returns nothing
f_vpDraw(array<box> bx, array<line> ln, int xEnd) =>
    if vMaxI >= vMinI and not na(vStart)
        float tot = 0.0
        int poc = vMinI
        for i = vMinI to vMaxI
            v = array.get(vVol, i)
            tot += v
            if v > array.get(vVol, poc)
                poc := i
        if tot > 0
            // value area: grow from POC toward the heavier side
            int lo = poc
            int hi = poc
            float acc = array.get(vVol, poc)
            while acc < tot * vpVA / 100.0 and (lo > vMinI or hi < vMaxI)
                float up = hi < vMaxI ? array.get(vVol, hi + 1) : -1.0
                float dn = lo > vMinI ? array.get(vVol, lo - 1) : -1.0
                if up >= dn
                    hi += 1
                    acc += up
                else
                    lo -= 1
                    acc += dn
            maxV = array.get(vVol, poc)
            span = math.max(1, xEnd - vStart)
            for i = vMinI to vMaxI
                v = array.get(vVol, i)
                if v > 0
                    w = math.max(1, math.round(v / maxV * span * vpWidth / 100.0))
                    top = vBase + (i + 1) * vBin
                    bot = vBase + i * vBin
                    c = i == poc ? color.new(colPOC, 30) : (i >= lo and i <= hi ? colVPin : colVPout)
                    array.push(bx, box.new(vStart, top, vStart + w, bot, border_color=color.new(c, 100), bgcolor=c))
            pocP = vBase + (poc + 0.5) * vBin
            vahP = vBase + (hi + 1) * vBin
            valP = vBase + lo * vBin
            array.push(ln, line.new(vStart, pocP, xEnd, pocP, color=colPOC, width=2))
            array.push(ln, line.new(vStart, vahP, xEnd, vahP, color=colVAL, width=1, style=line.style_dashed))
            array.push(ln, line.new(vStart, valP, xEnd, valP, color=colVAL, width=1, style=line.style_dashed))

if showVP
    // a new session: freeze yesterday's profile, then reset
    if rthStart
        if not na(vStart)
            f_vpDraw(vpHist, vpHistL, vEnd)
            // keep only the last N days (about 3 lines per day)
            while array.size(vpHistL) > vpDays * 3
                line.delete(array.shift(vpHistL))
            while array.size(vpHist) > 330
                box.delete(array.shift(vpHist))
        array.fill(vVol, 0.0)
        vBin := math.max(syminfo.mintick, close * vpPct / 100.0)
        vBase := open - (N_BINS / 2) * vBin
        vStart := bar_index
        vMinI := N_BINS
        vMaxI := -1
    if inRTH and not na(vBase)
        vEnd := bar_index
        iLo = math.max(0, math.min(N_BINS - 1, int(math.floor((low - vBase) / vBin))))
        iHi = math.max(0, math.min(N_BINS - 1, int(math.floor((high - vBase) / vBin))))
        n = iHi - iLo + 1
        vol = nz(volume)
        for i = iLo to iHi
            array.set(vVol, i, array.get(vVol, i) + vol / n)
        vMinI := math.min(vMinI, iLo)
        vMaxI := math.max(vMaxI, iHi)
    // today's profile, redrawn live on the last bar
    if barstate.islast
        for b in vpLive
            box.delete(b)
        for l in vpLiveL
            line.delete(l)
        array.clear(vpLive)
        array.clear(vpLiveL)
        f_vpDraw(vpLive, vpLiveL, bar_index)
