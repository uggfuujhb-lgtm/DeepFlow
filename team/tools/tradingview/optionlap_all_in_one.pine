//@version=6
// OptionLap · all-in-one: Gamma + Delta heatmap + Opening Range + IB + daily Volume Profile + absorption (on the price chart),
// OR/IB scanner for 8 symbols (one alert), and the CVD panel (this indicator's own pane under the chart).
// Price drawings use force_overlay so they stay on the candles. For education only, not a recommendation.
indicator("OptionLap · All-in-one", shorttitle="OL All", overlay=false, max_lines_count=400, max_labels_count=300, max_boxes_count=500)

// ───────── الشركة المعروضة ─────────
grpX = "يعرض لفلات الشركة المفتوحة بالشارت بس"
spxAlias = input.string("SPX,SPX500,US500,ES1!,MES1!", "رموز سباكس", group=grpX, tooltip="أي شارت من هالرموز يعرض لفلات SPX")

