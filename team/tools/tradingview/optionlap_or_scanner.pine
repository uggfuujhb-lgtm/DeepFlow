//@version=6
// OptionLap · OR / IB break scanner for 8 symbols with ONE alert (put it on any 5-minute chart).
// Clean break = 5-min close beyond the level by brkPct% with a small wick in the break direction (the owner's rule).
// OR = 9:30-9:45 New York (5:30-5:45 PM Riyadh); IB = 9:30-10:30 (until 6:30 PM Riyadh). Before 10:30 NY the message says "watch only".
// Create the alert: Condition = OL OR Scan -> "Any alert() function call", Open-ended. For education only, not a recommendation.
indicator("OptionLap · OR/IB Scanner (8)", shorttitle="OL OR Scan", overlay=false)

grp = "الرموز"
s1 = input.symbol("SP:SPX", "1", group=grp)
s2 = input.symbol("NASDAQ:AAPL", "2", group=grp)
s3 = input.symbol("NASDAQ:MSFT", "3", group=grp)
s4 = input.symbol("NASDAQ:NVDA", "4", group=grp)
s5 = input.symbol("NASDAQ:AMZN", "5", group=grp)
s6 = input.symbol("NASDAQ:GOOGL", "6", group=grp)
s7 = input.symbol("NASDAQ:META", "7", group=grp)
s8 = input.symbol("NASDAQ:TSLA", "8", group=grp)
grpF = "الفلتر"
tz      = input.string("America/New_York", "المنطقة الزمنية", group=grpF)
brkPct  = input.float(0.10, "الإغلاق أبعد من المستوى بـ %", minval=0, step=0.05, group=grpF)
wickMax = input.int(30, "أقصى ذيل باتجاه الكسر %", minval=0, maxval=100, group=grpF)
doIB    = input.bool(true, "نبّه على كسر الـIB كمان", group=grpF)

// runs inside each symbol's 5-minute series: returns which clean breaks happened on this bar
// code: 0 none, 1 OR up, -1 OR down, 2 IB up, -2 IB down (OR checked first)
f_scan() =>
    inOR = not na(time("5", "0930-0945", tz))
    inIB = not na(time("5", "0930-1030", tz))
    inRTH = not na(time("5", "0930-1600", tz))
    newDay = ta.change(time("D", "", tz)) != 0
    var float orH = na
    var float orL = na
    var float ibH = na
    var float ibL = na
    var bool oU = false
    var bool oD = false
    var bool iU = false
    var bool iD = false
    if newDay
        orH := na
        orL := na
        ibH := na
        ibL := na
        oU := false
        oD := false
        iU := false
        iD := false
    if inOR
        orH := na(orH) ? high : math.max(orH, high)
        orL := na(orL) ? low : math.min(orL, low)
    if inIB
        ibH := na(ibH) ? high : math.max(ibH, high)
        ibL := na(ibL) ? low : math.min(ibL, low)
    rng = math.max(high - low, syminfo.mintick)
    upOK = (high - math.max(open, close)) / rng * 100 <= wickMax
    dnOK = (math.min(open, close) - low) / rng * 100 <= wickMax
    int code = 0
    if inRTH and not inOR and not na(orH)
        if not oU and close > orH * (1 + brkPct / 100) and upOK
            oU := true
            code := 1
        else if not oD and close < orL * (1 - brkPct / 100) and dnOK
            oD := true
            code := -1
    if code == 0 and inRTH and not inIB and not na(ibH)
        if not iU and close > ibH * (1 + brkPct / 100) and upOK
            iU := true
            code := 2
        else if not iD and close < ibL * (1 - brkPct / 100) and dnOK
            iD := true
            code := -2
    afterIB = not inIB and inRTH
    [code, close, afterIB]

[c1, p1, a1] = request.security(s1, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c2, p2, a2] = request.security(s2, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c3, p3, a3] = request.security(s3, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c4, p4, a4] = request.security(s4, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c5, p5, a5] = request.security(s5, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c6, p6, a6] = request.security(s6, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c7, p7, a7] = request.security(s7, "5", f_scan(), lookahead=barmerge.lookahead_off)
[c8, p8, a8] = request.security(s8, "5", f_scan(), lookahead=barmerge.lookahead_off)

f_msg(string sym, int code, float px, bool after) =>
    string m = ""
    if code != 0 and (doIB or math.abs(code) == 1)
        what = math.abs(code) == 1 ? "الأوبن رينج" : "الـIB"
        dir = code > 0 ? "↑ فوق" : "↓ تحت"
        m := str.replace_all(sym, "NASDAQ:", "") + " · كسر " + what + " " + dir + " عند " + str.tostring(px, "#.##") + (after ? "" : " · قبل 6:30 م: راقب بس") + "\n"
    m

msg = f_msg(s1, c1, p1, a1) + f_msg(s2, c2, p2, a2) + f_msg(s3, c3, p3, a3) + f_msg(s4, c4, p4, a4) + f_msg(s5, c5, p5, a5) + f_msg(s6, c6, p6, a6) + f_msg(s7, c7, p7, a7) + f_msg(s8, c8, p8, a8)
if str.length(msg) > 0 and barstate.isconfirmed
    alert(msg + "مع الاتجاه بس، وبعد خسارتين وقّف. للتعليم فقط وليست توصية.", alert.freq_once_per_bar_close)

// a strip so you can see when breaks happened: +1 up, -1 down for any symbol
anyUp = c1 > 0 or c2 > 0 or c3 > 0 or c4 > 0 or c5 > 0 or c6 > 0 or c7 > 0 or c8 > 0
anyDn = c1 < 0 or c2 < 0 or c3 < 0 or c4 < 0 or c5 < 0 or c6 < 0 or c7 < 0 or c8 < 0
plot(anyUp ? 1 : anyDn ? -1 : 0, "كسر (أي رمز)", color=anyUp ? #2EF2C8 : anyDn ? #C98A6A : color.gray, style=plot.style_columns)
if barstate.islast and timeframe.period != "5"
    var label w = label.new(bar_index, 0, "حط السكانر على شارت 5 دقايق", color=color.new(color.red, 20), textcolor=color.white)
